# Backend Environment Configuration
# Copy this file to .env and fill in your values.

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=futurefund

# Authentication
JWT_SECRET=futurefund_super_secret_key_change_in_production

# CORS — Allowed frontend origins (comma-separated for production)
# In development, all origins are allowed.
# In production, set this to your actual frontend URL:
# ALLOWED_ORIGINS=https://futurefund.vercel.app,https://www.futurefund.com
